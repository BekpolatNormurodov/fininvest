# ── Backend ─────────────────────────────────────────────
# Dev MySQL via docker-compose.dev.yml (separate from credit-core: port 3308, db `fininvest`).
DATABASE_URL="mysql://root:root@localhost:3308/fininvest"

JWT_SECRET="change-me-to-a-long-random-string"
JWT_EXPIRES_IN="7d"

# Local disk storage for uploaded documents (relative to backend cwd).
UPLOAD_DIR="./uploads"

BACKEND_PORT=3000

# Comma-separated origins allowed by CORS (dev).
CORS_ORIGINS="http://localhost:5173,http://localhost:5174,http://localhost:5175,http://localhost:5176"

# ── Frontends (Vite) ────────────────────────────────────
# Each web app reads VITE_API_URL at build/dev time.
VITE_API_URL="http://localhost:3000"
